# ============================================================
# Variáveis de ambiente do template (NUNCA commitar credenciais reais)
# Copie este arquivo para `.env` e preencha com valores reais.
# ============================================================

NODE_ENV=development

# Servidor
PORT=3000
APP_PREFIX=template-api

# Banco de dados (SQLite local para testes)
DATABASE_URL=file:./dev.db

# Autenticação JWT (troque o secret em produção)
JWT_SECRET=change-me-em-producao
JWT_EXPIRES_IN=8h

# CORS - origens permitidas em produção (separadas por vírgula)
CORS_ORIGINS=http://localhost:3001,http://localhost:4200

# Logs operacionais (Winston + rotação)
LOG_DIR=./logs
LOG_LEVEL=info
